    "deploy": "gh-pages -b master -d build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "format": "prettier --write \"./**/*.{js,ts,tsx,css,json,scss}\"",
    "check-format": "prettier -c \"./**/*.{js,ts,tsx,css,json,scss}\"",
