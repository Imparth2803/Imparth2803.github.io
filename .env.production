# Public build settings (no secrets here; this file is committed).
# The site's address. Used for share-preview tags and page metadata, so the
# domain can change without code edits. No trailing slash.
REACT_APP_SITE_URL=https://parthtawde.is-a.dev
# Ship the webpack runtime as a file instead of an inline <script>, so the
# Content-Security-Policy in public/index.html can forbid inline scripts.
INLINE_RUNTIME_CHUNK=false
